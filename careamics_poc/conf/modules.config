process {

   withName: 'TRAIN_N2V' {
    publishDir = [
        [
            path: { "${params.output_path}/config_n2v" },
            mode: 'copy',
            pattern: '*.yaml',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ],
        publishDir = [
            path: "${params.output_path}/train_n2v",
            pattern: "checkpoints/last.ckpt",
            mode: "copy"
        
    ]
    ]
    ext.args = [
        "--data_type ${params.data_type}",
        "--experiment_name ${params.exp_name}",
        "--batch_size ${params.batch_size}",
        "--patch_size '${params.patch_size}'",
        "--num_epochs ${params.num_epochs}",
        "--axes ${params.axes}",
        "--use_n2v2 ${params.use_n2v2}",
      //  "--val_data ${params.val_data}"
        "--struct_n2v_axis ${params.structn2vaxis}",
        "--struct_n2v_span ${params.structn2vspan}"
    ].join(' ').trim()
}
   withName: 'TRAIN_N2N'{
      publishDir = [
        [
            path: { "${params.output_path}/config_N2N" },
            mode: 'copy',
            pattern: '*.yaml',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ],
        publishDir = [
            path: "${params.output_path}/train_n2n",
            pattern: "checkpoints/last.ckpt",
            mode: "copy"     
    ]
    ]
    ext.args = [
        "--data_type ${params.data_type}",
        "--experiment_name ${params.exp_name}",
        "--batch_size ${params.batch_size}",
        "--patch_size '${params.patch_size}'",
        "--num_epochs ${params.num_epochs}",
        "--axes ${params.axes}",
        "--loss ${params.loss}",
    ].join(' ').trim()
   }
      withName: 'TRAIN_CARE'{
      publishDir = [
        [
            path: { "${params.output_path}/config_care" },
            mode: 'copy',
            pattern: '*.yaml',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ],
        publishDir = [
            path: "${params.output_path}/train_care",
            pattern: "checkpoints/last.ckpt",
            mode: "copy"     
    ]
    ]
    ext.args = [
        "--data_type ${params.data_type}",
        "--experiment_name ${params.exp_name}",
        "--batch_size ${params.batch_size}",
        "--patch_size '${params.patch_size}'",
        "--num_epochs ${params.num_epochs}",
        "--axes ${params.axes}",
        "--loss ${params.loss}",
    ].join(' ').trim()
   }

   withName: 'PREDICT' {
      publishDir = [
            path: "${params.output_path}/predict",
            pattern: "predictions/*.${params.file_extension}",
            mode: "copy"
        ]
      ext.args = [
         "--tile_size '${params.tile_size}'",
         "--tile_overlap '${params.tile_overlap}'",
         "--axes ${params.test_axis}",
         "--data_type ${params.data_type}",
       //  "--no-tta-transforms",
         "--write_type ${params.write_type}",
         "--batch_size ${params.batch_size}"
         
      ].join(' ').trim()
   }




 
}
